LANCERS_URL=https://www.lancers.jp/work/search/system?open=1&ref=header_menu
LANCERS_URL1=https://www.lancers.jp/work/search/web?open=1&ref=header_menu
LANCERS_COOKIE=aws-waf-token=your_waf_token_here; _ga=...; CakeCookie[...]=...
TELEGRAM_BOT_TOKEN=1234567890:bot_token_for_url_1
TELEGRAM_BOT_TOKEN1=1234567890:bot_token_for_url_2
# Destination group/channel chat ids (negative numbers for groups/supergroups).
# Find them with: python lancers_fetch.py --discover-chats
# If TELEGRAM_CHAT_ID1 is omitted, both bots post to TELEGRAM_CHAT_ID.
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_CHAT_ID1=-1001234567890
POLL_INTERVAL=60
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=lancers
MONGODB_COLLECTION=post
